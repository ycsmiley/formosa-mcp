{
  "name": "formosa-mcp",
  "version": "0.1.0",
  "description": "讓 AI agent 懂台灣的 MCP server：發票對獎、台股（上市＋上櫃）；高鐵、台鐵開發中",
  "license": "MIT",
  "type": "module",
  "bin": {
    "formosa-mcp": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "taiwan",
    "mcp",
    "invoice",
    "model-context-protocol",
    "統一發票"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "build:tpex": "node scripts/build-tpex.mjs",
    "collect:tpex": "tsx scripts/collect-tpex.ts",
    "live-check": "npm run build && tsx scripts/live-check.ts",
    "dev:worker": "wrangler dev --test-scheduled",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "remote-check": "tsx scripts/remote-check.ts",
    "build:plugin": "node scripts/build-plugin.mjs",
    "plugin-check": "tsx scripts/plugin-check.ts",
    "rail-demo": "npm run build && tsx scripts/rail-demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^26.6.5",
    "agents": "0.30.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "4.153.0",
    "esbuild": "0.28.2"
  },
  "main": "dist/core/index.js",
  "exports": {
    ".": "./dist/core/index.js",
    "./mcp": "./dist/mcp/server.js"
  }
}
