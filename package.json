{
  "name": "formosa-mcp",
  "version": "0.1.0",
  "description": "台灣發票、台股、垃圾車、停水停電與高鐵／台鐵資訊；本機鐵路工具須自備 TDX 金鑰",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycsmiley/formosa-mcp.git"
  },
  "homepage": "https://github.com/ycsmiley/formosa-mcp#readme",
  "bugs": {
    "url": "https://github.com/ycsmiley/formosa-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "formosa-mcp": "dist/stdio.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "taiwan",
    "mcp",
    "invoice",
    "twse",
    "tpex",
    "model-context-protocol",
    "統一發票"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "build:tpex": "node scripts/build-tpex.mjs",
    "collect:tpex": "tsx scripts/collect-tpex.ts",
    "live-check": "npm run build && tsx scripts/live-check.ts",
    "dev:worker": "wrangler dev --test-scheduled",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "remote-check": "tsx scripts/remote-check.ts",
    "abuse-test": "node scripts/abuse-test.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "plugin-check": "tsx scripts/plugin-check.ts",
    "rail-demo": "npm run build && tsx scripts/rail-demo.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "build:collectors": "node scripts/build-collectors.mjs",
    "collect:garbage": "tsx scripts/collect-garbage.ts",
    "collect:outages": "tsx scripts/collect-outages.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^26.6.5",
    "agents": "0.30.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "4.153.0",
    "esbuild": "0.28.2"
  },
  "main": "dist/core/index.js",
  "exports": {
    ".": "./dist/core/index.js",
    "./mcp": "./dist/mcp/server.js"
  },
  "mcpName": "io.github.ycsmiley/formosa-mcp"
}
