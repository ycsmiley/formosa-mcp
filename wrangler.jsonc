{
  "name": "formosa-mcp",
  "main": "src/worker/index.ts",
  // Previews were deliberately disabled in the dashboard; a deploy without this would re-enable them.
  "preview_urls": false,
  "workers_dev": true,
  // Newest date supported by the pinned worker test pool (workerd 2026-08-15).
  "compatibility_date": "2026-08-15",
  // KV namespace "SNAPSHOTS" (production). Not a secret; local dev/tests use local storage.
  "kv_namespaces": [{ "binding": "SNAPSHOTS", "id": "e92149e1efec4434835310d434b69f7d" }],
  // SQLite-backed Durable Objects are available on Workers Free.
  "durable_objects": { "bindings": [{ "name": "MCP_RATE_LIMIT", "class_name": "FixedWindowCounter" }, { "name": "TDX_GATEWAY", "class_name": "TdxGateway" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FixedWindowCounter"] }, { "tag": "v2", "new_sqlite_classes": ["TdxGateway"] }],
  "triggers": { "crons": [
    // TWSE: UTC Mon–Fri :00/:30 = Taipei Mon 08:00–Sat 07:30, every 30m.
    // Also checks TPEx fallback at 11:00/12:30 UTC (Taipei 19:00/20:30).
    "0,30 * * * MON-FRI",
    // TPEx snapshots are written by .github/workflows/tpex-collect.yml.
    // Weekend TWSE only: UTC Sat/Sun 00/06/12/18 :00 = Taipei 08/14/20/02 :00.
    "0 */6 * * SAT,SUN",
    // Invoice: every 3h UTC 00–21 = Taipei 08/11/14/17/20/23/02/05.
    "0 */3 * * *",
    // Invoice draw day: odd months, UTC 25th 05:00–15:50 = Taipei 13:00–23:50, every 10m.
    "*/10 5-15 25 1,3,5,7,9,11 *"
    // Rail snapshots are written by .github/workflows/rail-snapshot.yml.
  ] }
}
