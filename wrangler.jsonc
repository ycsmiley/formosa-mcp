{
  "name": "formosa-mcp",
  "main": "src/worker/index.ts",
  // Newest date supported by the pinned worker test pool (workerd 2026-08-15).
  "compatibility_date": "2026-08-15",
  // Placeholder: replace with a real namespace ID before any future deployment.
  "kv_namespaces": [{ "binding": "SNAPSHOTS", "id": "00000000000000000000000000000000" }],
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "triggers": { "crons": [
    // TWSE: UTC Mon–Fri :00/:30 = Taipei Mon 08:00–Sat 07:30, every 30m.
    "0,30 * * * MON-FRI",
    // TPEx: UTC Mon–Fri :15/:45 = Taipei Mon 08:15–Sat 07:45, every 30m.
    "15,45 * * * MON-FRI",
    // Weekend UTC Sat/Sun 00/06/12/18 :00 TWSE, :30 TPEx = Taipei 08/14/20/02 :00/:30.
    "0,30 */6 * * SAT,SUN",
    // Invoice: every 3h UTC 00–21 = Taipei 08/11/14/17/20/23/02/05.
    "0 */3 * * *",
    // Invoice draw day: odd months, UTC 25th 05:00–15:50 = Taipei 13:00–23:50, every 10m.
    "*/10 5-15 25 1,3,5,7,9,11 *"
  ] }
}
